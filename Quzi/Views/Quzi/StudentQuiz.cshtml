<script>
    const allQuestions = @Html.Raw(Json.Serialize(Model));
    let filteredQuestions = [];
    let currentIdx = 0;
    let score = 0;
    let answered = [];

    function startQuiz(cls) {
        filteredQuestions = allQuestions.filter(q => q.target_Class === cls);
        if (filteredQuestions.length === 0) {
            alert('No questions for Class ' + cls);
            return;
        }

        document.getElementById('class-selection').style.display = 'none';
        document.getElementById('quiz-area').style.display = 'block';
        document.getElementById('class-badge').textContent = 'Class ' + cls;

        currentIdx = 0;
        score = 0;
        answered = new Array(filteredQuestions.length).fill(false);
        renderQuestion();
    }

    function renderQuestion() {
        const q = filteredQuestions[currentIdx];
        const total = filteredQuestions.length;

        document.getElementById('q-text').textContent = q.question_Text;
        document.getElementById('progress-text').textContent = `Question ${currentIdx + 1} of ${total}`;
        document.getElementById('progress-bar').style.width = `${((currentIdx + 1) / total) * 100}%`;

        const container = document.getElementById('options-container');
        container.innerHTML = '';

        const opts = [
            { label: 'A', value: q.option_A, key: 'Option_A' },
            { label: 'B', value: q.option_B, key: 'Option_B' },
            { label: 'C', value: q.option_C, key: 'Option_C' },
            { label: 'D', value: q.option_D, key: 'Option_D' }
        ];

        opts.forEach(opt => {
            const div = document.createElement('div');
            div.className = 'option-card d-flex align-items-center';
            div.innerHTML = `<div class="option-prefix">${opt.label}</div><div class="option-text ms-3">${opt.value}</div>`;
            div.onclick = () => selectOption(opt.key);
            container.appendChild(div);
        });

        const solBox = document.getElementById('solution-box');
        const solText = document.getElementById('solution-text');
        if (answered[currentIdx]) {
            solBox.classList.add('show');
            solText.textContent = q.solution_Explanation;
            document.getElementById('next-btn').disabled = false;
        } else {
            solBox.classList.remove('show');
            document.getElementById('next-btn').disabled = true;
        }

        document.getElementById('prev-btn').disabled = currentIdx === 0;
        document.getElementById('next-btn').innerHTML = (currentIdx === total - 1) 
            ? 'Finish <i class="bi bi-check-all"></i>' 
            : 'Next <i class="bi bi-arrow-right"></i>';
    }

    function selectOption(key) {
        if (answered[currentIdx]) return;
        answered[currentIdx] = true;

        const q = filteredQuestions[currentIdx];
        const correct = q.correct_Answer;

        if (key === correct) score++;

        const opts = document.querySelectorAll('#options-container .option-card');
        opts.forEach(opt => {
            const label = opt.querySelector('.option-prefix').textContent;
            const optKey = 'Option_' + label;
            if (optKey === correct) opt.classList.add('correct');
            else if (optKey === key) opt.classList.add('wrong');
        });

        document.getElementById('solution-box').classList.add('show');
        document.getElementById('solution-text').textContent = q.solution_Explanation;
        document.getElementById('next-btn').disabled = false;
    }

    function nextQ() {
        if (currentIdx < filteredQuestions.length - 1) {
            currentIdx++;
            renderQuestion();
        } else {
            showResult();
        }
    }

    function prevQ() {
        if (currentIdx > 0) {
            currentIdx--;
            renderQuestion();
        }
    }

    function showResult() {
        document.getElementById('quiz-area').style.display = 'none';
        document.getElementById('result-area').style.display = 'block';
        document.getElementById('score-display').textContent = `${score} / ${filteredQuestions.length}`;
    }
</script> *@

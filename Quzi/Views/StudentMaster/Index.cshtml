@model Quzi.Models.StudentList
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Student";
}


    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            body {
                background: linear-gradient(to right, #667eea, #764ba2);
                min-height: 100vh;
            }

            .form-container {
                background: #fff;
                border-radius: 15px;
                padding: 30px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.2);
            }

            .form-title {
                font-weight: 600;
                color: #444;
            }

            .form-control {
                border-radius: 8px;
            }

            .btn-custom {
                border-radius: 8px;
                padding: 8px 20px;
            }

            #preview {
                width: 100px;
                height: 100px;
                border-radius: 10px;
                object-fit: cover;
                display: none;
                border: 2px solid #ddd;
            }
    </style>



    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
    
        <div class="form-container col-md-10 col-lg-8">
            <h3 class="text-center mb-4 form-title">🎓 Student Registration Form</h3>

            <form method="post" asp-action="Index" enctype="multipart/form-data">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="Enter name" required>
                        <span asp-validation-for="Name" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Father Name</label>
                        <input type="text" asp-for="Father" class="form-control" placeholder="Enter father name" required>
                        <span asp-validation-for="Father" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mobile Number</label>
                        <input type="number" asp-for="Mobile" class="form-control" placeholder="Enter mobile number" required>
                        <span asp-validation-for="Mobile" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" asp-for="Email" class="form-control" placeholder="Enter email" required>
                        <span asp-validation-for="Email" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Date of Birth</label>
                        <input type="date" asp-for="Dob" class="form-control" required>
                        <span asp-validation-for="Dob" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Class</label>
                        <select asp-for="Class" class="form-control">
                            <option>Select Class</option>
                            <option value="1">1st</option>
                                            <option value="2">2nd</option>
                                            <option value="3">3rd</option>
                                            <option value="4">4th</option>
                                            <option value="5">5th</option>
                        </select>
                        <span asp-validation-for="Class" class="text-bg-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <textarea class="form-control" asp-for="Address" rows="2" placeholder="Enter address"></textarea>
                        <span asp-validation-for="Address" class="text-bg-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Upload Image</label>
                                        <input type="file" name="Image" id="images" class="form-control">
                        @* <span asp-validation-for="Image" class="text-bg-danger"></span> *@
                    </div>

                    <div class="col-md-6 text-center">
                        <img id="preview">
                    </div>

                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success btn-custom">Save</button>
                    <button type="reset" class="btn btn-danger btn-custom">Reset</button>
                </div>

            </form>
        </div>

    </div>

    <script>
            // Image Preview
                                document.getElementById("images").addEventListener("change", function () {
                                const file = this.files[0];
                                if (file) {
                                    const reader = new FileReader();
                                    reader.onload = function (e) {
                                        let preview = document.getElementById("preview");
                                        preview.src = e.target.result;
                                        preview.style.display = "block";
                                    };
                                    reader.readAsDataURL(file);
                                }
                            });
    </script>

    @section Scripts{
                        <partial name="_ValidationScriptsPartial.cshtml" />
    }
                    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
                    @if (TempData["error"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: '@TempData["error"]'
        });
    </script>
}
                    
